{
  "name": "companyconnect-lead-to-quote-automation-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Client-safe TypeScript API demonstrator for validated lead qualification, next-action recommendations, quote briefs, and audit trails.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "4.22.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/express": "5.0.1",
    "@types/node": "22.13.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.22.0",
    "globals": "15.15.0",
    "prettier": "3.5.3",
    "supertest": "7.1.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vitest": "3.2.6"
  }
}
